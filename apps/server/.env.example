# Sao chép file này thành ".env" (cùng thư mục apps/server) rồi điền giá trị thật.
# Không commit file .env — đã có trong .gitignore. Dùng chung cho cả chạy
# trực tiếp (pnpm dev:server / PM2) và Docker (deploy/docker-compose.yml).

# --- Bắt buộc ---

# Token bot lấy từ @BotFather trên Telegram.
TELEGRAM_BOT_TOKEN=

# Danh sách Telegram ID được phép dùng bot, cách nhau bởi dấu phẩy.
# Lấy ID của bạn bằng cách nhắn /start cho @userinfobot.
ALLOWED_TELEGRAM_IDS=

# --- Server ---

PORT=3333
# Docker đặt SERVER_HOST=0.0.0.0 để nhận kết nối qua cổng được publish;
# chạy trực tiếp/PM2 giữ localhost mặc định này.
SERVER_HOST=127.0.0.1
# Múi giờ dùng cho mọi phép tính ngày/tuần/tháng và lịch chạy tự động.
TZ=Asia/Ho_Chi_Minh
# Đường dẫn file SQLite (thư mục cha sẽ tự được tạo nếu chưa có).
# Trong Docker, biến này đã được đặt sẵn = /data/chitieu.db (ổ /data là volume).
DB_PATH=./data/chitieu.db
# Chỉ cần đặt khi thư mục web/dist không nằm cạnh apps/server (đúng là trường
# hợp của Docker — Dockerfile đã tự đặt biến này, không cần sửa gì thêm).
WEB_DIST_PATH=

# --- Bot Telegram ---

# polling: bot tự hỏi Telegram liên tục (đơn giản, dùng cho dev và server nhỏ).
# webhook: Telegram gọi ngược về PUBLIC_URL/telegram/webhook (cần PUBLIC_URL).
BOT_MODE=polling
# Domain công khai của bạn qua Cloudflare Tunnel — bắt buộc nếu BOT_MODE=webhook,
# cũng dùng để hiển thị link/kiểm tra CSRF cho web.
PUBLIC_URL=https://chitieu.cuongmc.id.vn
# Chỉ cần khi BOT_MODE=webhook — chuỗi bí mật tùy chọn để Telegram xác thực webhook.
TELEGRAM_WEBHOOK_SECRET=

# --- Lịch chạy tự động (cú pháp cron, theo TZ ở trên) ---

WEEKLY_REPORT_CRON=0 20 * * 0
MONTHLY_REPORT_CRON=0 8 1 * *
DAILY_REMINDER_CRON=30 21 * * *
# Giờ tự ghi các chi phí cố định đến hạn (ngay sau nửa đêm).
FIXED_COST_CRON=5 0 * * *

# --- Bộ phân tích tin nhắn ---

# Số trần nhỏ hơn ngưỡng này được hiểu là "nghìn đồng" (vd: "bánh mì 20" = 20.000).
BARE_NUMBER_THRESHOLD=1000

# --- Đoán danh mục bằng LLM (tùy chọn, tắt mặc định) ---
# Chạy NỀN sau khi đã trả lời — không ảnh hưởng tốc độ phản hồi.
# Ví dụ dùng ai-box.vn (chuẩn OpenAI); có thể đổi sang nhà cung cấp khác cùng chuẩn.

LLM_ENABLED=false
LLM_BASE_URL=https://api.ai-box.vn/v1
LLM_API_KEY=
LLM_MODEL=

# --- Sao lưu tự động ---

# Thư mục chứa các bản sao lưu .db (trong Docker đã đặt sẵn = /data/backups).
BACKUP_DIR=./backups
# Giờ sao lưu hằng ngày (cú pháp cron, theo TZ ở trên).
BACKUP_CRON=0 3 * * *
# Giữ lại bao nhiêu bản gần nhất.
BACKUP_KEEP=30
# Tùy chọn: gửi thêm bản sao lưu (đã gzip) vào một chat Telegram — dùng
# chính Telegram ID của bạn để bot tự gửi cho bạn.
BACKUP_TELEGRAM_CHAT_ID=

# --- Đồng bộ Actual Budget (tùy chọn, tắt mặc định) ---
# Chỉ bật khi có đủ 3 biến ACTUAL_SERVER_URL/ACTUAL_PASSWORD/ACTUAL_SYNC_ID.
# SQLite luôn là nguồn dữ liệu gốc — Actual lỗi thì chỉ ghi log, không ảnh
# hưởng bot/web/app.

ACTUAL_SERVER_URL=
ACTUAL_PASSWORD=
ACTUAL_SYNC_ID=
# Chỉ cần nếu budget trên Actual có đặt mật khẩu mã hóa (end-to-end encryption).
ACTUAL_ENCRYPTION_PASSWORD=
# Tên tài khoản (account) sẽ tạo/dùng trong Actual để chứa các giao dịch này.
ACTUAL_ACCOUNT_NAME=Chi Tiêu
# Đồng bộ cho user nào (Telegram ID) — để trống thì dùng ID nhỏ nhất trong
# ALLOWED_TELEGRAM_IDS (thường là chính bạn).
ACTUAL_USER_TELEGRAM_ID=
# Bao nhiêu phút đồng bộ một lần.
ACTUAL_SYNC_INTERVAL_MIN=5
# Thư mục Actual lưu cache budget đã tải về (trong Docker đã đặt sẵn = /data/actual).
ACTUAL_DATA_DIR=./data/actual

# --- Log ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
