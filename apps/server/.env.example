# Sao chép file này thành ".env" (cùng thư mục apps/server) rồi điền giá trị thật.
# Không commit file .env — đã có trong .gitignore.

# --- Bắt buộc ---

# Token bot lấy từ @BotFather trên Telegram.
TELEGRAM_BOT_TOKEN=

# Danh sách Telegram ID được phép dùng bot, cách nhau bởi dấu phẩy.
# Lấy ID của bạn bằng cách nhắn /start cho @userinfobot.
ALLOWED_TELEGRAM_IDS=

# --- Server ---

PORT=3000
# Múi giờ dùng cho mọi phép tính ngày/tuần/tháng và lịch chạy tự động.
TZ=Asia/Ho_Chi_Minh
# Đường dẫn file SQLite (thư mục cha sẽ tự được tạo nếu chưa có).
DB_PATH=./data/chitieu.db

# --- Bot Telegram ---

# polling: bot tự hỏi Telegram liên tục (đơn giản, dùng cho dev và server nhỏ).
# webhook: Telegram gọi ngược về PUBLIC_URL/telegram/webhook (cần PUBLIC_URL).
BOT_MODE=polling
# Chỉ cần khi BOT_MODE=webhook — domain công khai của bạn (qua Cloudflare Tunnel).
PUBLIC_URL=
# Chỉ cần khi BOT_MODE=webhook — chuỗi bí mật tùy chọn để Telegram xác thực webhook.
TELEGRAM_WEBHOOK_SECRET=

# --- Lịch chạy tự động (cú pháp cron, theo TZ ở trên) ---

WEEKLY_REPORT_CRON=0 20 * * 0
MONTHLY_REPORT_CRON=0 8 1 * *
DAILY_REMINDER_CRON=30 21 * * *

# --- Bộ phân tích tin nhắn ---

# Số trần nhỏ hơn ngưỡng này được hiểu là "nghìn đồng" (vd: "bánh mì 20" = 20.000).
BARE_NUMBER_THRESHOLD=1000

# --- Đoán danh mục bằng LLM (tùy chọn, tắt mặc định) ---
# Chạy NỀN sau khi đã trả lời — không ảnh hưởng tốc độ phản hồi.
# Ví dụ dùng ai-box.vn (chuẩn OpenAI); có thể đổi sang nhà cung cấp khác cùng chuẩn.

LLM_ENABLED=false
LLM_BASE_URL=https://api.ai-box.vn/v1
LLM_API_KEY=
LLM_MODEL=

# --- Đồng bộ Actual Budget (tùy chọn, tắt mặc định — xem README ở giai đoạn 5) ---

ACTUAL_SERVER_URL=
ACTUAL_PASSWORD=
ACTUAL_SYNC_ID=

# --- Log ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
