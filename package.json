{
  "name": "chitieu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bot Telegram ghi chi tiêu siêu nhanh + website + app iOS",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "pnpm --filter @chitieu/server dev",
    "dev:web": "pnpm --filter @chitieu/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "parse": "pnpm --filter @chitieu/core parse"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
